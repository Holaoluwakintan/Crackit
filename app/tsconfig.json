{
 "compilerOptions": {
  "target": "ES2020",
  "module": "ESNext",
  "moduleResolution": "bundler",
  "lib": [
   "ES2020",
   "DOM",
   "DOM.Iterable"
  ],
  "jsx": "react-jsx",
  "jsxImportSource": "preact",
  "strict": true,
  "noEmit": true,
  "skipLibCheck": true,
  "noUnusedLocals": true,
  "resolveJsonModule": true,
  "isolatedModules": true,
  "allowJs": true,
  "checkJs": false
 },
 "include": [
  "src",
  "vite.config.ts"
 ]
}